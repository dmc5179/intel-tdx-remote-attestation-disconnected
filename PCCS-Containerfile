FROM registry.redhat.io/rhel9/nodejs-20

USER root

RUN dnf --disableplugin=subscription-manager install -y git openssl && \
    dnf --disableplugin=subscription-manager clean all && \
    rm -rf /var/cache/yum /var/cache/dnf

WORKDIR /opt/intel/sgx-dcap-pccs

RUN git clone https://github.com/intel/confidential-computing.tee.dcap.pccs.git /tmp/pccs-src && \
    cp -r /tmp/pccs-src/service/* . && \
    rm -rf /tmp/pccs-src

RUN npm install

RUN mkdir -p data ssl_key && \
    openssl req -x509 -newkey rsa:4096 -keyout ssl_key/private.pem -out ssl_key/file.crt \
      -days 3650 -nodes -subj "/CN=PCCS" && \
    chown -R 1001:0 /opt/intel/sgx-dcap-pccs && \
    chmod -R g=u /opt/intel/sgx-dcap-pccs

COPY pccs-config.json config/default.json

EXPOSE 8081

USER 1001

CMD ["node", "pccs_server.js"]
