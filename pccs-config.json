{
    "HTTPS_PORT": 8081,
    "hosts": "0.0.0.0",
    "uri": "https://api.trustedservices.intel.com/sgx/certification/v4/",
    "ApiKey": "",
    "proxy": "",
    "RefreshSchedule": "0 0 1 * *",
    "UserTokenHash": "REPLACE_WITH_SHA512_HASH_OF_YOUR_USER_TOKEN",
    "AdminTokenHash": "REPLACE_WITH_SHA512_HASH_OF_YOUR_ADMIN_TOKEN",
